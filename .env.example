# QuantSynthica Market API Configuration

API_TITLE="QuantSynthica Market API"
API_VERSION="1.0.0"
API_PORT=8000
API_HOST="0.0.0.0"
DEBUG=True

# Security
API_KEY="qs_live_dev_secret_key_12345"
API_KEY_REQUIRED=False

# Redis Cache
REDIS_URL="redis://localhost:6379/0"
